# Copy to .env.local (gitignored) and fill in from the Supabase dashboard:
# Project Settings -> API

# Public. Safe in the browser and in git-tracked config -- row level security,
# not secrecy, is what protects the data.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# The same host again, prefixed so it reaches the browser. /admin needs it to
# talk to Supabase; the un-prefixed one above stays Node-only, which is what
# keeps the VITE_ prefix meaning exactly "this is in the bundle".
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=

# Optional override. This is already the default, so it only needs setting to
# point somewhere else. Served through the host's proxy rather than straight
# from Supabase, so the CDN absorbs repeat traffic and every image stays
# same-origin (which is what makes canvas exports possible).
# VITE_REGISTRY_URL=/media/registry/registry.json

# SECRET. Bypasses row level security completely. Used only by
# scripts/migrate-to-supabase.mjs, never by the app, and never with a VITE_
# prefix -- anything VITE_-prefixed is compiled into the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=

# --- deployment only (set these in Vercel, not here) ------------------------
#
# CRON_SECRET
#   Vercel sends `Authorization: Bearer $CRON_SECRET` on cron invocations.
#   /api/daily refuses every request without it -- a cron endpoint is an
#   ordinary public URL, so without this anyone could call it in a loop and
#   trigger a deploy each time. Any long random string.
#
# VERCEL_DEPLOY_HOOK
#   Project Settings -> Git -> Deploy Hooks. Optional: the daily function uses
#   it to redeploy when the published registry has moved past the snapshot
#   compiled into the running build. Deliberately NOT VITE_-prefixed -- in the
#   browser bundle it would be a denial-of-service waiting to happen.
#   Without it the bundled fallback simply drifts until the next deploy.
